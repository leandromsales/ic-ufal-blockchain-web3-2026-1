# Copie para .env: cp .env.example .env (o .env não deve ir para o Git).

# --- Consensys Infura (Sepolia) ---
# 1. Acesse https://www.infura.io/ e faça login (conta Consensys).
# 2. Crie um API Key (Web3 API) e um projeto; em "Endpoints" habilite Sepolia (Ethereum).
# 3. Copie o HTTPS da rede Sepolia — formato:
#    https://sepolia.infura.io/v3/<SUA_API_KEY>
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/SUA_INFURA_API_KEY

# Chave privada — sincronizada automaticamente ao rodar `npm run chain` (conta #0 do hardhat node).
# Tambem pode preencher manualmente para outra carteira (ex. MetaMask no no) ou Sepolia.
# 64 hex, com ou sem 0x. Sepolia: obrigatoria se nao usar conta padrao.
PRIVATE_KEY=

# RPC do no local (opcional; padrao http://127.0.0.1:8545) — usado por npm run admin
# LOCAL_RPC_URL=http://127.0.0.1:8545

# --- Frontend: fonte em .env → frontend/config.js (npm run generate-config) ---
# CONTRACT_ADDRESS: copie da saída de `npm run deploy:local` (Hardhat local costuma ser o endereço abaixo).
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Block explorer (protocolo + hostname; paths com placeholders)
BLOCK_EXPLORER_ORIGIN=https://sepolia.etherscan.io
BLOCK_EXPLORER_TX_PATH=/tx/{txHash}
BLOCK_EXPLORER_ADDRESS_PATH=/address/{address}
# Chain ID da rede Hardhat local (padrão do hardhat node)
HARDHAT_LOCAL_CHAIN_ID=31337
# Chain ID Sepolia (testnet)
SEPOLIA_CHAIN_ID=11155111
# Endereço do TransferProxy (deploy automático via npm run deploy:local)
PROXY_ADDRESS=
